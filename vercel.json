{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node --version",
  "buildCommand": "node scripts/build-vercel-proxy.mjs",
  "outputDirectory": "vercel-public",
  "functions": {"api/site-proxy.mjs": {"maxDuration": 300}},
  "rewrites": [{"source": "/:path*", "destination": "/api/site-proxy?__path=/:path*"}]
}
