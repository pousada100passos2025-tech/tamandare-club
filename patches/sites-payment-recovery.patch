--- /dev/null
+++ b/lib/order-recovery.ts
@@ -0,0 +1,8 @@
+export type OrderReference={id:string;token:string;paymentMethod?:string};
+export function recoveryBody(ref:OrderReference,saved:unknown,method:string):Record<string,unknown>{
+ const entry=saved&&typeof saved==='object'?saved as Record<string,unknown>:null;
+ const payload=entry?.id===ref.id&&entry.token===ref.token&&entry.payload&&typeof entry.payload==='object'?entry.payload as Record<string,unknown>:null;
+ const original=payload?.paymentMethod||ref.paymentMethod||method;
+ const paymentMethod=original==='card'?'card':'pix';
+ return payload?{...payload,...ref,paymentMethod}:{...ref,paymentMethod,action:'resume'};
+}
diff --git a/lib/proxy-identity.ts b/lib/proxy-identity.ts
new file mode 100644
index 0000000..49e2326
--- /dev/null
+++ b/lib/proxy-identity.ts
@@ -0,0 +1,10 @@
+export async function requestIp(request:Request,secret:string){
+ const fallback=request.headers.get('cf-connecting-ip')||'unknown';
+ const ip=request.headers.get('x-tamandare-proxy-ip')||'',at=request.headers.get('x-tamandare-proxy-at')||'',signature=request.headers.get('x-tamandare-proxy-signature')||'';
+ if(!secret||!ip||ip.length>64||!/^[0-9a-f:.]+$/i.test(ip)||!/^\d{13}$/.test(at)||Math.abs(Date.now()-Number(at))>60000||!/^[a-f0-9]{64}$/.test(signature))return fallback;
+ try{
+  const key=await crypto.subtle.importKey('raw',new TextEncoder().encode(secret),{name:'HMAC',hash:'SHA-256'},false,['verify']);
+  const bytes=Uint8Array.from(signature.match(/../g)!,s=>parseInt(s,16));
+  return await crypto.subtle.verify('HMAC',key,bytes,new TextEncoder().encode(at+'\n'+ip))?ip:fallback;
+ }catch{return fallback;}
+}
